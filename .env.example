# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Public (also embedded in config.js — safe to expose)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SECRET — server/admin use only (scripts, GitHub Actions secrets)
SUPABASE_SECRET_KEY=sb_secret_xxx
# Use the *Session pooler* string (IPv4). The "Direct" string is IPv6-only.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Shared site login (only used by scripts/create-login.sh)
APP_LOGIN_USERNAME=robotics11
APP_LOGIN_PASSWORD=change-me
